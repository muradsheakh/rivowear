PORT=4000
NODE_ENV=development

# PostgreSQL connection (docker-compose sets this for you)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rivowear
# Max connections THIS server keeps open. servers x this number must stay below PostgreSQL's max_connections (default 100).
DB_POOL_SIZE=10
# Only if DATABASE_URL goes through PgBouncer (transaction mode): live tracking needs a direct connection to PostgreSQL.
# LISTEN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rivowear

# Where your website runs (used for CORS and for links inside SMS/email)
CLIENT_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
# Public address of THIS API (used for uploaded image links and payment callbacks)
PUBLIC_API_URL=http://localhost:4000

# REQUIRED in production: long random string used to sign logins
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created automatically on the very first start.
# Development falls back to admin@rivowear.com / Admin@123 when these are blank.
# Set both explicitly in production; the default password is rejected there.
ADMIN_CONTACT=
ADMIN_PASSWORD=
# Set false in production if you do not want the 12 demo products added to an empty database
SEED_DEMO_PRODUCTS=true

UPLOAD_DIR=uploads

# Customers can review only after the order is Delivered. Set false to allow right after ordering.
REVIEW_REQUIRES_DELIVERY=true

# true = Cash on Delivery orders need the customer to confirm their phone with an SMS code (fewer fake orders).
# Needs a working SMS provider below; each code is one SMS. Leave false until SMS is connected.
CHECKOUT_OTP=false

# --- Couriers ---
# Courier pre-selected in the admin panel and used by "bulk send". Today: steadfast.
# OTHER COURIERS (Pathao, RedX, Paperfly, eCourier ...): not connected yet. In the admin panel pick "Other courier (manual)" to
# type the courier name + tracking code by hand, or see backend/README.md "Adding another courier" to connect one by API.
DEFAULT_COURIER=steadfast

# --- Steadfast courier (portal.packzy.com > Settings > API) ---
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# OFFLINE SETUP (webhook): make up a long random string (e.g. `openssl rand -hex 32`), put it here AND in the Steadfast panel
# as the webhook Auth Token. Leave empty to keep using the 10-minute polling only.
STEADFAST_WEBHOOK_TOKEN=

# --- SMS (provider: brevo, bulksmsbd or console) ---
SMS_PROVIDER=console
# Brevo: create an API key in Brevo, and configure a transactional SMS sender.
# SMS credits/country permissions may be required by Brevo before delivery.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Email (any SMTP: Gmail app password, Brevo, Zoho ...) ---
# Brevo SMTP relay: smtp-relay.brevo.com:587; use the SMTP login/key and a verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rivowear <no-reply@yourdomain.com>

# --- Online payment: SSLCommerz (gives bKash, Nagad, Rocket, cards, banks on one page) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# false = sandbox, true = real money
SSLCOMMERZ_LIVE=false
